# Host público do site e do subdomínio de faturação
NEXT_PUBLIC_SITE_URL=https://www.jelly.pt
NEXT_PUBLIC_BILLING_HOST=billing.jelly.pt

# Segredo para assinar os magic links (32+ bytes aleatórios)
BILLING_AUTH_SECRET=

# Envio de email transacional. Basta uma chave: usa-se o Brevo se existir.
BREVO_API_KEY=
RESEND_API_KEY=

# Quem assina cada área. Os domínios jelly.pt e jelly.agency estão autenticados
# no Brevo (DKIM e DMARC), por isso qualquer endereço neles sai assinado sem ter
# de ser validado um a um. Estes são os valores por omissão do código — só se
# define aqui para mudar um endereço sem tocar no código.
MAIL_FROM="Jelly <hello@jelly.pt>"
TALENT_FROM_EMAIL="Jelly Talento <talent@jelly.pt>"
BLOG_FROM_EMAIL="Jelly <blog@jelly.agency>"
BILLING_FROM_EMAIL="Jelly <pagamentos@jelly.pt>"

# Para onde vão os avisos internos
CONTACT_TO_EMAIL=gmalho@jelly.pt
TALENT_TO_EMAIL=talent@jelly.pt

# Formulário Monday embebido na área de faturação
NEXT_PUBLIC_MONDAY_FORM_URL=

# Payload: Postgres (Neon) e segredo das sessões do painel
DATABASE_URL=
PAYLOAD_SECRET=

# Ficheiros do painel no Blob da Vercel (obrigatório em produção)
BLOB_READ_WRITE_TOKEN=

# Pipedrive: um briefing novo abre um negócio na primeira etapa do pipeline.
# Sem chave, não abre nada e o formulário funciona igual. A chave cria-se em
# Settings → Personal preferences → API. Os ids por omissão são os que a conta
# já usa (pipeline comercial, etapa "A contactar").
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_PIPELINE_ID=1
PIPEDRIVE_STAGE_ID=24
# Quem fica dono do negócio. Vazio: o utilizador da chave.
PIPEDRIVE_OWNER_ID=
# O campo onde o texto do briefing é guardado.
PIPEDRIVE_FIELD_BRIEFING=80534f41dd48cbda026a5071a8fc651ce451aaa7

# Assistentes do painel: escrever o resumo de um artigo, descrever uma imagem,
# ler um CV. Sem chave, os botões respondem a dizer que falta a chave — o painel
# funciona igual, só sem eles.
ANTHROPIC_API_KEY=

# As comunicações da Jelly. A lista vive no Brevo — aqui só se guarda o número
# dela. Sem este número a subscrição responde a dizer que não conseguiu, e nada
# se perde: quem confirmou sem lista entra assim que ela for configurada.
BREVO_LIST_ID=

# Porta B: um CV que chegou a talent@jelly.pt e a equipa reenvia à mão para um
# endereço que o sistema lê. O subdomínio cvs.jelly.pt tem MX para o Brevo (ver
# docs/DEPLOY.md); o endereço não se publica em sítio nenhum. Sem estas duas, o
# webhook recusa tudo — é o que se quer enquanto não estiver configurado.
CV_INBOUND_ADDRESS=
CV_INBOUND_SECRET=

# Purga manual do site: POST /api/revalidate
REVALIDATE_SECRET=
