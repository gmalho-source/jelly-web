# Host público do site e do subdomínio de faturação
NEXT_PUBLIC_SITE_URL=https://www.jelly.pt
NEXT_PUBLIC_BILLING_HOST=billing.jelly.pt

# Segredo para assinar os magic links (32+ bytes aleatórios)
BILLING_AUTH_SECRET=

# Envio de email transacional
RESEND_API_KEY=
BILLING_FROM_EMAIL="Jelly <pagamentos@jelly.pt>"

# Formulário Monday embebido na área de faturação
NEXT_PUBLIC_MONDAY_FORM_URL=

# Sanity (fase 2 — enquanto vazio, o site usa o conteúdo local de src/content)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
# Só para o seed (node scripts/sanity-seed.mjs), nunca no runtime do site
SANITY_API_WRITE_TOKEN=
# Segredo do webhook de revalidação (Authorization: Bearer …)
SANITY_REVALIDATE_SECRET=
