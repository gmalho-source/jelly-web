node_modules
.next
out
.env
.env*.local
*.tsbuildinfo
next-env.d.ts
.DS_Store

# Fontes comerciais em teste: licenciadas ao utilizador, não ao repositório
public/fonts/trials/*.woff2
public/fonts/trials/*.ttf
public/fonts/trials/*.otf

# Exports do WordPress: despejo do site antigo, não fonte de verdade
content-import/*.xml

# Compilação temporária do conteúdo para a migração do Payload
.cache/

# Ficheiros carregados no painel em desenvolvimento (em produção vão para o Blob).
# Com barra à frente: só a pasta da raiz. Sem ela, a regra apanhava também
# `public/media/`, e uma imagem posta lá ficava de fora do repositório sem o
# `git add` dizer nada — foi assim que a fotografia do recrutamento não chegou
# ao site, e o defeito só se vê em produção.
/media/
# O mesmo para os CV e os anexos, que em desenvolvimento caem aqui.
/documents/
/attachments/

# Registo de ids do Payload: um por base de dados, nunca partilhado
content-import/payload-media.*.json
content-import/payload-media.json
